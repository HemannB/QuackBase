<resources>
    <style name="Theme.QuackBase" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_yellow</item>
        <item name="colorPrimaryVariant">@color/brand_yellow_dark</item>
        <item name="colorOnPrimary">@color/text_primary</item>
        <item name="colorSecondary">@color/brand_yellow</item>
        <item name="colorSecondaryVariant">@color/brand_yellow_dark</item>
        <item name="colorOnSecondary">@color/text_primary</item>
        <item name="android:statusBarColor">@android:color/white</item>
        <item name="android:navigationBarColor">@android:color/white</item>
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="Theme.QuackBase.Dashboard" parent="Theme.QuackBase">
        <item name="android:windowBackground">@color/background_muted</item>
    </style>
</resources>
