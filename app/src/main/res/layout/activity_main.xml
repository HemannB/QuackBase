<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ImageView
        android:layout_width="170dp"
        android:layout_height="170dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="48dp"
        android:contentDescription="@string/quackbase_logo"
        android:scaleType="fitCenter"
        android:src="@drawable/rubber_duck" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <Button
        android:id="@+id/btnGetStarted"
        android:layout_width="220dp"
        android:layout_height="54dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_button_primary"
        android:backgroundTint="@color/brand_yellow"
        android:text="@string/get_started"
        android:textAllCaps="false"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        android:textStyle="bold" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:contentDescription="@string/footer_signature_description"
        android:scaleType="fitCenter"
        android:src="@drawable/footer_signature" />

</LinearLayout>
